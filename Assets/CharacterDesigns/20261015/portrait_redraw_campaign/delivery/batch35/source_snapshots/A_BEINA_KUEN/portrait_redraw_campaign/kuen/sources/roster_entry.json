    {
      "source": "design/04_人物/城市人物/人物_ASH-NPC-KUEN_枯恩.md",
      "fields": {
        "稳定ID": "ASH-NPC-KUEN",
        "身份": "奥娅成年伴侣、能自主表达的患者",
        "所求": "继续过日子，也想让伴侣真歇一段。",
        "所怕": "一说愿换人就被当完全不需要伴侣，或拿受苦换她永远留下。",
        "口吻": "说具体哪一步需要帮，不用“我都行”让别人猜。",
        "跨案弧线": "02可选择普通替护或短轮班，仍想见奥娅却不把爱作排班表；03可拒观察仍要普通照护，主章可自行另选地点，不由米娅代表。",
        "体貌": "三十多岁，气色偏白，坐时背垫着布卷；手背有留置针的旧青。",
        "衣着与磨损": "病号布衫外披厚披肩，是奥娅织的；袜口松软。",
        "随身物": "一杯温水与写着‘哪一步需要帮’的布条。",
        "举止": "说话具体：‘喝水要人扶，翻身不用’；被代表时会摇头。",
        "风格守卫": "不写成爱情考题；需要帮助与不想拖累可以同时成立。"
      }
    }
  ],
