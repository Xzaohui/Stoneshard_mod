      "fields": {
        "工作": "新原创护林者。",
        "起点与转折": "觉得沉默就是忠诚，后来必须听不愿交名者。",
        "体貌": "三十多岁，步子轻，耳力好；手背有树枝划出的细痕。",
        "衣着与磨损": "护林短披配绑腿，帽檐压低；腰上挂着口哨。",
        "随身物": "口哨与巡段图，图上用炭笔圈着最近段。",
        "举止": "说话前先听林里的动静；被问边界时会指树不指人。",
        "风格守卫": "不写成林地法官；他画的是界，不是判决。"
      }
    }
