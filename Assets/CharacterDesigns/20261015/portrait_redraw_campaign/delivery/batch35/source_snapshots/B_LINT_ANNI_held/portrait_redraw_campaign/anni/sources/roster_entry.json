      "source": "design/04_人物/城市人物/人物_ASH-NPC-ANNI_安妮.md",
      "fields": {
        "稳定ID": "ASH-NPC-ANNI",
        "身份": "限定当班普通护理者",
        "所求": "在能接的班里把人真接好，自己也按时交班。",
        "所怕": "一答应照看就被宣传成整年有人，失手还得一个人承担。",
        "口吻": "指这班的凳和人，不靠医术奇迹许治愈；护理与研究用不同语气问。",
        "跨案弧线": "02完成真到班可给奥娅休息；03停止观察只释放本批已实有人手，不能复制自己两班；主章仍可拒另一份新工约。",
        "体貌": "二十多岁，手腕有力，手背有消毒水纹；头发束成低髻。",
        "衣着与磨损": "护理班的素褂，袖口用扣带；口袋插着备用布带与剪刀。",
        "随身物": "当班木牌与一本只记本班的簿子。",
        "举止": "先报到班人，再报余量；被塞下一班时会指簿子说‘明天问’。",
        "风格守卫": "不写成无限人手；她只签这一班。"
      }
    }
  ],
