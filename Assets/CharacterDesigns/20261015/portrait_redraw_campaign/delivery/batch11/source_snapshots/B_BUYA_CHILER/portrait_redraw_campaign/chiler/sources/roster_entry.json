    {
      "source": "design/04_人物/城市人物/人物_ALD-NPC-CHILER_齐勒.md",
      "fields": {
        "稳定ID": "ALD-NPC-CHILER",
        "工作": "旧墙讲述导者",
        "所求": "用卖得动的故事养自己与一个助手。",
        "所怕": "说清未知之后，听客把他当什么都不知道的人，退款让下一班无钱。",
        "口吻": "开场善用你看这道裂；被指出年代时不再把大家都这么说当来源。",
        "可能弧线": "可缩小讲述范围留下可信生意，也可停卖虚标游约退款；不必靠害怕新围城继续谋生。",
        "体貌": "六十岁上下，声音洪亮，耳背却坚持不用号；手掌宽厚。",
        "衣着与磨损": "旧式长袍配现代腰带，帽檐插着一根细粉笔。",
        "随身物": "粉笔与折叠的旧墙简图，图上注着讲与不讲的段落。",
        "举止": "开讲先敲墙三下；被追问时会说‘这段我不讲’。",
        "风格守卫": "不写成官方史官；他讲的版本也有取舍。"
      }
    }
  ],
