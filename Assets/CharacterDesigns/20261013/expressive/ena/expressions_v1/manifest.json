  "expressions": [
    {
      "key": "ena_E1_practical_challenge",
      "label": "生计质问",
      "brows": "眉内端降低、外段略提，与锚的内眉上扬显著不同；一侧略高。",
      "eyes": "上眼睑打开到中等，直看对话者；保锚成熟偏长眼型，非怒瞪圆眼。",
      "mouth": "小幅斜向开口，短句问话口型，唇角一侧略紧；不微笑。",
      "head_pose": "下巴水平、头微向听者前倾，肩与旧衣固定。",
      "story_support": "当前N2-DEFAULT“肯承认他死”却要放弃欠薪的矛盾；卡中眼前先吃饭。",
      "condition_and_limit": "是现实质问和讨生活，不是假定丈夫已死、已知藏身点或已领取补偿。"
    },
    {
      "key": "ena_E2_address_concern",
      "label": "住址担忧",
      "brows": "双眉内端明显抬高并轻聚，外端下降；不要加新额纹。",
      "eyes": "视线偏向画侧，上眼睑稍压、下眼睑有一点紧张；与E1直视、E3稳视拉开。",
      "mouth": "双唇闭合但微向内收，嘴角轻下压，保原清晰薄唇；无泪和咬破唇。",
      "head_pose": "头略偏低回看对话者，保头巾完整结与下垂端。",
      "story_support": "N2-S04-L01“他们会问他住哪”只作有条件场面素材；人物卡不要求丈夫为赔付公开住址。",
      "condition_and_limit": "是担心隐私被索取，不表达地址已泄露、丈夫已经返回、保护完成或新增威胁。"
    },
    {
      "key": "ena_E3_leave_him_choice",
      "label": "坚定留选择",
      "brows": "眉形舒平，内端仅轻低；不复制E1的质问挑眉或E2的八字忧眉。",
      "eyes": "目光正向而稳定，上下睑放松但保持清醒；眼裂较E2稍开。",
      "mouth": "小而横向的发言开口，唇角平且无甜笑，像把一句话说完。",
      "head_pose": "头近正面、下巴稍抬，肩颈松稳；不要用手势担当区别。",
      "story_support": "N2-S04-L03“让他自己选”为条件场面素材；当前N3 X04-L01“不能替他坐进证人席”及ARC-02有限代理／保留说不支持此意。",
      "condition_and_limit": "不宣布人物弧光已永久完成，也不擅写丈夫同意；若使用N3原句，需resolve_N2∈[protected,agency]、有限回执已核和说话者存活在场愿谈。"
    }
  ],
