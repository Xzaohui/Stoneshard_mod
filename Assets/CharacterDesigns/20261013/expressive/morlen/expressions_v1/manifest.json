  "expressions": [
    {
      "key": "morlen_E1_concerned_listen",
      "label": "疲惫关切",
      "brows": "双眉内端微提，外段顺下，保灰眉厚度。",
      "eyes": "上睑略垂，下睑放松；瞳孔朝稍低的画外说话者，不能闭目。",
      "mouth": "双唇闭合微松，嘴角轻下垂，胡须中唇线清楚。",
      "head_pose": "原三分之二角，下颏略收。",
      "story_support": "N7-DEFAULT对被漏列护理者的关切；卡中保护伤患的职责。",
      "condition_and_limit": "只是倾听与挂心，不画病人、不添病症，不证明给药、治愈或任何人同意。"
    },
    {
      "key": "morlen_E2_limited_self_account",
      "label": "谨慎自述",
      "brows": "一侧眉内端提起，另一眉压平，区别E1对称忧眉。",
      "eyes": "视线低向侧前，眼裂比E1稍窄而瞳孔仍见，非羞愧闭眼。",
      "mouth": "嘴小幅纵向分开，像艰难选择准确措辞；不咧嘴露齿。",
      "head_pose": "头稍偏侧，肩仍固定。",
      "story_support": "N7-R-parallel-L01知道而没说的部分须单独算；N13-R-hearing-L01先放上自己知道却没说的部分。",
      "condition_and_limit": "两条路线是各自条件素材，不连续播放；使用原句分别需resolve_N7=parallel或resolve_N13=hearing及对应核验、本人存活在场愿谈。脸只表示审慎自述，不独立认证认罪或全面悔改，也不证明提交材料。"
    },
    {
      "key": "morlen_E3_consent_objection",
      "label": "克制异议",
      "brows": "双眉内端压低、外段近水平，不重复前两态提眉。",
      "eyes": "眼睑明显打开至清醒直视，不瞪圆眼。",
      "mouth": "横向短句开口，唇角平，口腔仅少量暗色，无怒吼齿列。",
      "head_pose": "头近正面，下颏水平。",
      "story_support": "N13-DEFAULT不以未来替眼前人签同意；N13-R-contract-L01赔偿不得要求见面、握手或原谅。",
      "condition_and_limit": "通用异议不代表已签补偿约；原contract句仅resolve_N13=contract且本人存活在场愿谈。若以后借X39旁听语境，另须resolve_SQ07=independent与有限回执核验；图不移交主持权。"
    }
  ],
