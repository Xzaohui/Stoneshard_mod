      "fields": {
        "稳定ID": "KOR-NPC-TAFEI",
        "工作": "埃文的旧同行与本件原代取人",
        "所求": "把曾帮带回物的好意留住，也想取回自己实际垫的修理款。",
        "所怕": "埃文否认全权家属等于否认所有同行日子，或垫款从此没人认。",
        "口吻": "先讲哪段路陪过，再讲这一件领过；不能把帮过接成以后可以全代签。",
        "可能弧线": "承认自称家属超过原授权，真修理款本笔另核；本人可限准再次取物，也可撤代理，不逼认血缘。",
        "体貌": "四十多岁，步子稳，手掌有常年提箱的横茧；鬓角早白。",
        "衣着与磨损": "耐磨的行脚褂，襟内缝着证物袋；帽檐压得低。",
        "随身物": "代取回执与旧同行名录，名录缺了一页。",
        "举止": "交接前先念单号；被问旧事时说‘那件我只送到门口’。",
        "风格守卫": "不写成忠诚跟班；代取范围止于那一件。"
      }
    }
  ],
