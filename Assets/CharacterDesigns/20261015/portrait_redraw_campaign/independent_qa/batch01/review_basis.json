  "authority_notes": {
    "mia": "CITY-NPC-NPC-MIA; 三十多岁，苍白，病号布衫与自缝毯角，只替自己回答。",
    "ena": "NPC-N-ENA; 三十多岁，纳拉妻子，素色外衣、旧披巾，疲惫却务实。历史表情源混有MAE-S03艾娜卡，不沿用。",
    "nara": "NPC-N-NARA; 四十岁上下，绞盘维修工，旧短褂，先看出口、保护行踪。",
    "nell": "NPC-N-NELL; 四十多岁，劳务书记，深色罩衣，伏案红痕，谨慎担责，非幕后主使。",
    "sel": "NPC-N-SEL; 五十岁上下，工坊债票地方经手人，旧围裙，不画成冷血债主。"
