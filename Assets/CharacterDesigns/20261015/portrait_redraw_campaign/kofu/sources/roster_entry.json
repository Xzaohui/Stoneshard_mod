      "fields": {
        "稳定ID": "OSB-NPC-KOFU",
        "工作": "德娅的成年女儿与井旁菜地使用权请求人",
        "所求": "能成家，也保自己种过的菜地和不必先求夫家同意的取水。",
        "所怕": "说不交地被当不爱人，拒婚又被母亲算成一笔没回本的礼。",
        "口吻": "分清愿婚的一句和愿移地的一句，少拿体面当自己的话。",
        "可能弧线": "婚与地分开仍可续或再拒；暂停也认真实礼物归属，公共用水不作惩罚。",
        "体貌": "二十多岁，皮肤晒成麦色，掌纹里嵌着土；走路带风。",
        "衣着与磨损": "母亲的旧围裙改小，头巾是自己染的浅蓝。",
        "随身物": "菜种布袋与半张写着界线的纸。",
        "举止": "说话直，先讲自己种了什么；被当成孩子时会拍手上的土。",
        "风格守卫": "不写成夺产女儿；婚事与地权分开谈。"
      }
    }
  ],
