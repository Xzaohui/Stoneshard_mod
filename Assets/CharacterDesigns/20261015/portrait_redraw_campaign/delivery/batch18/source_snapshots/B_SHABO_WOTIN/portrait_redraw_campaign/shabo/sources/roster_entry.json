      "fields": {
        "稳定ID": "PAS-NPC-SHABO",
        "工作": "关外本案普通护理当班人",
        "所求": "真接本次普通床、饭水与护理，不以拿研究资料才能开始照看。",
        "所怕": "莫伦旧权没交却被写成她主持，或军民各列一次让同床看似能接两人。",
        "口吻": "说这班实际能做哪段，不说受冷发热就证明全部配对原因。",
        "可能弧线": "受真有限护理交班与主持范围，不代N7技术认证；专业判断未知保未知，不能永远免费接边境所有人。",
        "体貌": "三十多岁，手腕稳，手背有反复消毒的白纹；短发利落。",
        "衣着与磨损": "素色护理褂，外罩防风短披；口袋插着温度布条。",
        "随身物": "当班簿与体温布条，簿子按班次划格。",
        "举止": "先看人再看单；被塞额外名字时会说‘先核床位’。",
        "风格守卫": "不写成万能护士；她只接这一班与实有床位。"
      }
    }
  ],
