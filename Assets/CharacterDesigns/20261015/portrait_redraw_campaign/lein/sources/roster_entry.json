  "current_card_fields": [
    {
      "source": "design/04_人物/城市人物/人物_HIG-NPC-LEIN_蕾因.md",
      "fields": {
        "稳定ID": "HIG-NPC-LEIN",
        "身份": "接过观景客约的成年向导",
        "所求": "把客人真带回，也怕退订失旅费和信誉。",
        "所怕": "停牌让自己过往夸大的广告被认出，觉得自己再无工作。",
        "口吻": "先谈客人已付的路费，受质疑会承认写过无需等待。",
        "跨案弧线": "01须撤免检通行说法并承认退款/改约，主章可改做真实外道引路；03少展示便宜少收入，但不把原承诺失约推给维护者。",
        "体貌": "三十多岁，步子快，小腿有常年走山路的紧实；说话带手势。",
        "衣着与磨损": "向导短披配耐磨绑腿，帽檐别着一截粉笔；背包侧袋插着客约卷。",
        "随身物": "客约卷与粉笔，卷上写着免等承诺的那一行。",
        "举止": "报价先报路况；被追问承诺时会承认自己写过什么。",
        "风格守卫": "不写成奸商；免等广告是她的责任，不是整座山的罪。"
      }
    }
  ],
