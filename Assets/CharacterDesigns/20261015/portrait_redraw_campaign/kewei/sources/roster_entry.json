  "current_card_fields": [
    {
      "source": "design/04_人物/城市人物/人物_FOR-NPC-KEWEI_科蔚.md",
      "fields": {
        "稳定ID": "FOR-NPC-KEWEI",
        "工作": "本段有限矿份出资者",
        "所求": "保可兑现的收益，也不让一次停井使自己全失投资。",
        "所怕": "承认隐过维护价后所有赔付都变成无限向他索钱。",
        "口吻": "说本笔现金、矿份与承诺，不能把纸上的金价当手里可用钱。",
        "可能弧线": "实际扣有限池付旧薪、停班与处理水，各有缺口；认责任不必做圣人，拒余项仍欠，不能买安全复工结论。",
        "体貌": "五十岁上下，肚子微鼓，手指戴两枚素戒；握手很用力。",
        "衣着与磨损": "耐脏的深色外套，内袋鼓着账册；靴底加厚。",
        "随身物": "账册与矿份牌，牌上按份数刻格。",
        "举止": "先谈份数再谈人；被问到井下细节会承认‘我没下去过’。",
        "风格守卫": "不写成恶东家；出资与下井是两回事。"
      }
    }
  ],
