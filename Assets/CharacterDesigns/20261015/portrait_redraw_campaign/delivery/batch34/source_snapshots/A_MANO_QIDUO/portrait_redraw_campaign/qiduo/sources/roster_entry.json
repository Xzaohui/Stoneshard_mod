      "fields": {
        "稳定ID": "FOR-NPC-QIDUO",
        "工作": "艾钦的成年兄长与伤矿工",
        "所求": "真领旧工资、保自己去留，矿份收益另谈。",
        "所怕": "为让家人能吃饭再伤一次，或说不下井便被判忘了祖父。",
        "口吻": "能说何时出的井，不能替仍在井下的人报平安；杯是祖辈留下，不是新班牌。",
        "可能弧线": "救出后可留乡拿已核有限份、另作或真卖份退出；伤不会结案即治好，卖款分项本人问。",
        "体貌": "三十多岁，右手缠着护腕，咳嗽时按胸；头发被矿尘染灰。",
        "衣着与磨损": "矿工短褂加厚肩垫，裤脚扎进靴筒；护腕是自己缝的。",
        "随身物": "护腕与半截矿灯，灯罩有裂。",
        "举止": "说话常停下来喘；谈工时不谈伤痛，谈伤痛不谈工时。",
        "风格守卫": "不写成悲情矿工；伤是真的，班也是真的。"
      }
    }
  ],
