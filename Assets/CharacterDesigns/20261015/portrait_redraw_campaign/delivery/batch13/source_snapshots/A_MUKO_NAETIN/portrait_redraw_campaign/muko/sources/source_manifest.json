        "fields": {
          "稳定ID": "ALD-NPC-MUKO",
          "工作": "本案死者的兄弟",
          "所求": "留住自己所信的送别方式，尽快让停在驿里的葬务有着落。",
          "所怕": "退一步就像背弃兄弟，母亲的拒绝被看成羞辱自己。",
          "口吻": "把他小时候说过的话当凭据，受到追问才承认那不是临终选择。",
          "可能弧线": "分开仪式仍可互不理解；简葬让他承受没有完整仪式的难受，不把补助当迫母亲同信的工具。",
          "体貌": "二十多岁，比同龄人瘦，颈侧有一道烫伤旧痕；走路步子快。",
          "衣着与磨损": "工坊旧工装改短，臂上缠着孝布；鞋头开了口用线扎住。",
          "随身物": "哥哥的半块工作牌与一截断尺。",
          "举止": "急起来先动手比划再说话；被劝住时会退一步重讲。",
          "风格守卫": "不写成寻仇机器；他要的是账目与说法，不是血债。"
        }
      }
    ],
