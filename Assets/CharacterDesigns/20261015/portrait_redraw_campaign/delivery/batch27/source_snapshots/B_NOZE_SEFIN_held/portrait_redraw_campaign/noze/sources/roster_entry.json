      "fields": {
        "稳定ID": "DEN-NPC-NOZE",
        "工作": "迁来的补网工与救过孩子的家属",
        "所求": "继续有谋生方式，也认自己未问就借过共用网。",
        "所怕": "自己的错让所有迁来者被赶走，或为了证明救人再把孩子送到网边。",
        "口吻": "把借网、过载与救人那一刀分开讲，不让孩子替她向所有人求情。",
        "可能弧线": "可新借权共用或分有限小网；补好不抹未问，救人也不把全部份额送给她。",
        "体貌": "三十多岁，手臂结实，左腕戴着一根旧绳圈；说笑时眼先弯。",
        "衣着与磨损": "迁居带来的外地样式短褂，洗得发白；补网围裙是本地新做的。",
        "随身物": "补网针盒与孩子的旧鞋一只（挂在包外）。",
        "举止": "先问孩子，再谈自己；被夸救人时会摆手说‘那是当天’。",
        "风格守卫": "不写成外来英雄；恩情不折成永久特权。"
      }
    }
  ],
