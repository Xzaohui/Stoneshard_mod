      "fields": {
        "稳定ID": "EED-NPC-SUJIN",
        "工作": "原创弓材匠与家艺传人",
        "所求": "保留下手弯料的手艺和这一批工钱。",
        "所怕": "认曾假标健康树就再无人信她真有手艺。",
        "口吻": "手放在弯试床上说哪片料能用；“祖辈这样做”可以是哀伤也可以是借口。",
        "可能弧线": "承认截过订单，不因此被迫公开所有图样；选少量病料或旧料改法，各有工期与质量损失。",
        "体貌": "五十岁上下，指节粗大，右手食指有拉弦磨出的硬结；眼神沉静。",
        "衣着与磨损": "深绿工装，袖口和领口都磨出绒面；腰间挂着弦蜡。",
        "随身物": "弦蜡与一把用旧的小刨，刨身刻着家号。",
        "举止": "谈弓先谈木；被问传人时会看向院子里的练习靶。",
        "风格守卫": "不写成隐世宗师；家艺可传可不传，不强迫谁继承。"
      }
    }
  ],
