          "fields": {
            "工作": "原创旧织街工头。",
            "起点与转折": "想保护离乡者，也想把他们技术永远留给自己的工棚。",
            "体貌": "五十岁上下，手臂粗，手背有织机擦出的旧痕；走路步子重。",
            "衣着与磨损": "工头的旧短褂，肩部加厚；腰上挂着梭袋与哨。",
            "随身物": "哨与工班木牌，牌上按织机编号。",
            "举止": "说话前先看机器；被问旧怨时会说‘先看这班’。",
            "风格守卫": "不写成记仇机器；新班归新班，旧账另算。"
          }
        }
