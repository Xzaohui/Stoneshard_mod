    {
      "source": "design/04_人物/城市人物/人物_DEN-NPC-ELE_艾蕾.md",
      "fields": {
        "稳定ID": "DEN-NPC-ELE",
        "工作": "卡蕾与欧铎的成年女儿",
        "所求": "一家安全回岸，也不把自己的船位与新租约当父母可全权替签。",
        "所怕": "伤者挤进来时没人问她，或她说不就被解释为不肯救人。",
        "口吻": "先说这一趟自己愿不愿，再问要到哪个岸点；既能照护也能拒同船。",
        "可能弧线": "分船仍愿给有限岸上接应，同船也只认本航次；父母的许可不是她的自动许可。",
        "体貌": "二十岁上下，肤色晒得健康，辫子扎得紧；指甲修短便于补网。",
        "衣着与磨损": "母亲的旧围裙改短，系带换新；脚上是自纳的布鞋。",
        "随身物": "补网梭与自己的小记事板。",
        "举止": "说话直接，先表态再解释；被当孩子时会站直再说一遍。",
        "风格守卫": "不写成传话女儿；她的同意要自己给。"
      }
    }
  ],
