      "fields": {
        "稳定ID": "KOR-NPC-BILUO",
        "工作": "陌生旧画的本案寄售人",
        "所求": "卖画补实际旅费，也想从这张脸找到家里没讲完的人。",
        "所怕": "没有那段城主故事就只剩普通旧画，似乎家中也不值得被记住。",
        "口吻": "承认自己补过售价故事，不把想认识画中人伪成官方世系。",
        "可能弧线": "真未知价售或自愿有限留展都可，原物归属本笔另核；脸仍未知，不以高价购买城史真相。",
        "体貌": "三十多岁，气质与本地人不同，手腕戴着细银环；看画时会偏头。",
        "衣着与磨损": "两地样式混搭的外套，披肩是远地织法；行李轻便。",
        "随身物": "寄售单与画轴绑带，绑带上打着外地结法。",
        "举止": "谈画先谈来历的空白；被追问时笑说‘查不到就查不到’。",
        "风格守卫": "不写成神秘间谍；她只是来寄售一幅画。"
      }
    }
  ],
