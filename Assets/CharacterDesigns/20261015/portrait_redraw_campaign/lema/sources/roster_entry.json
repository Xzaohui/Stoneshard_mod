    {
      "source": "design/04_人物/城市人物/人物_OSB-NPC-LEMA_雷玛.md",
      "fields": {
        "稳定ID": "OSB-NPC-LEMA",
        "工作": "三篱中想退出的邻户",
        "所求": "保自己的牲口与回路，能拒下一季合作而不否定旧互助。",
        "所怕": "门被堵时没法真退出，续约又被听成永远欠最早出料的人。",
        "口吻": "承认旧篱护过自家，说现在仍想有自己门。",
        "可能弧线": "开侧门少共护、有自担维护；续一季有钥与撤条件，不强大家变朋友。",
        "体貌": "三十多岁，肤色偏白，肩窄；说话时习惯抱着手臂。",
        "衣着与磨损": "家中织的粗布衣，罩衫洗得发白；鞋是旧的但缝得整齐。",
        "随身物": "自家篱门钥匙与一页退出声明草稿。",
        "举止": "进门先说‘只谈一季’；被挽留时会低头看鞋。",
        "风格守卫": "不写成忘恩者；退出要按实条件办，不承担骂名。"
      }
    }
  ],
