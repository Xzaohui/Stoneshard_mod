          "fields": {
            "稳定ID": "ALD-NPC-KONA",
            "工作": "芬珂的兄长与小额订单联络人",
            "所求": "守住家门安全和家里几笔裁衬收入。",
            "所怕": "妹妹署名后他无法掌控来客，旧有家族风险被订单带回来。",
            "口吻": "我替你挡过谁说得很熟；妹妹问你替我答过什么时才说不下去。",
            "可能弧线": "可以学会只管自己的地址与联络，也可能仍拒帮她接公开订单；两种走向都不能代妹妹撤署名。",
            "体貌": "三十余岁，和妹妹眉眼相近但更宽；拇指有包装绳勒出的茧。",
            "衣着与磨损": "耐脏的深蓝短褂，肘部衬皮；腰间挂订单夹。",
            "随身物": "订单夹与一小卷包装绳，夹内页按客户分色。",
            "举止": "说话先报单号和交期；替妹妹出头前会先看她一眼。",
            "风格守卫": "不写成越权的兄长；他能联络订单，不能替妹妹答手艺。"
          }
        }
      ]
    }
