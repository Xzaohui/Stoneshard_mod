    {
      "source": "design/04_人物/城市人物/人物_OSB-NPC-RUIYIN_芮茵.md",
      "fields": {
        "稳定ID": "OSB-NPC-RUIYIN",
        "工作": "第三篱户与仍愿共护者",
        "所求": "保有限共同护田，也不让所有退料与新工钱压到自己。",
        "所怕": "只剩她一个出费用，或自己说贵被解释为支持堵门。",
        "口吻": "算自己这一季真能出哪份，承认少一户后的担心。",
        "可能弧线": "可以拒无限新料也不能挡另一户退出；有限共围需真份额与工班，互助不自动等共同所有权。",
        "体貌": "四十多岁，手大脚大，修篱时能一个人扶桩；嗓门亮。",
        "衣着与磨损": "耐刮的厚围裙，肩上有扛桩磨出的旧痕；头巾别着木钉。",
        "随身物": "修篱锤与三户共用的记工木牌。",
        "举止": "开口先说别人帮过什么；被误解时会大声重复一遍。",
        "风格守卫": "不写成道德绑架者；她愿意共护，不等于替人做主。"
      }
    }
  ],
