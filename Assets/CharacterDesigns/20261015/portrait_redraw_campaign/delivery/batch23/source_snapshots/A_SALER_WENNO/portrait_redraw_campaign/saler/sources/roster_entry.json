  "current_card_fields": [
    {
      "source": "design/04_人物/城市人物/人物_SKO-NPC-SALER_桑勒.md",
      "fields": {
        "稳定ID": "SKO-NPC-SALER",
        "工作": "本案寄柜兑筹中介",
        "所求": "保中介收入与所有家属仍信他能办成的名声。",
        "所怕": "家属分开查费用后看出他把寄费挪作自己的周转，又把已兑筹写成归人已到。",
        "口吻": "常说钱已经兑了；被问人在哪时只能报真实未知，不许拿另一归人当证明。",
        "可能弧线": "可退自己挪的有限部分并留未归未知，或拒交接由固定兑筹核；不以一次退款证明赎约已经履行。",
        "体貌": "四十岁，面皮松，笑纹深；数东西时手指极快。",
        "衣着与磨损": "半新不旧的商人短褂，里衬鼓着暗袋；帽子上缝着兑筹标记。",
        "随身物": "兑筹串与寄存牌，牌号按柜格排列。",
        "举止": "说话先报价目再问来意；被拆穿时笑一声重报。",
        "风格守卫": "不写成通用销赃口；他兑的是本案的筹。"
      }
    }
  ],
