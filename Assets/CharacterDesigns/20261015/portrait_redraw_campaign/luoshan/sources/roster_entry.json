      "fields": {
        "稳定ID": "OSB-NPC-LUOSHAN",
        "工作": "田庄外堤原创修筐匠与本次自愿导师",
        "所求": "教芙朵有限旧筐收口、断篾接法，让学作是真学而非给父债补工。",
        "所怕": "教过一次就被全家默认能永远免费收留，或学徒篾工被磨租人记成还父债。",
        "口吻": "把哪道接法说清，愿教也能说今天没空。",
        "可能弧线": "可真教一段、收明确工费并认学徒所作；不接全家旧欠，不替布林原匠签认证，以后是否续教另问。",
        "体貌": "五十多岁，手指被柳条割出密纹；弯腰久了会扶膝站起。",
        "衣着与磨损": "旧围裙上插满柳条断头，袖套到肘；草帽沿磨毛。",
        "随身物": "修筐刀与一把没编完的小筐。",
        "举止": "说话时手不停编；教人先让看三遍再上手。",
        "风格守卫": "不写成慈祥导师；她只教这一门，不管人前程。"
      }
    }
  ],
