        "稳定ID": "HIG-NPC-GURA",
        "身份": "只签本次外段的维护工",
        "所求": "领已做工钱，做能自己决定的下一班。",
        "所怕": "结束救援后被称英雄，就永远不能走；停会被说让井重新危险。",
        "口吻": "用这班/下班分句，交钥后仍可能想回来，但不是必须。",
        "跨案弧线": "主章可共同维护或拒参与留独行图；03实际结薪/交有限职责后再问续约，离任不撤已验证核心安全。",
        "体貌": "三十多岁，手上有冻疮旧痕，掌纹深；站着时习惯把重心放前脚。",
        "衣着与磨损": "维护工厚褂，膝部绑着旧垫；肩袋里插着短撬棍。",
        "随身物": "短撬棍与自己的工约短单，单上只写本段。",
        "举止": "签单前先把段号念一遍；被劝续约时会说‘下次再问’。",
        "风格守卫": "不写成终身守山人；她签的是这一班。"
      }
    }
  ],
