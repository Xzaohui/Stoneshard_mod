      "fields": {
        "稳定ID": "ASH-NPC-SUNE",
        "身份": "本批自愿观察记录员",
        "所求": "拿到可用记录，保住自己的有限差事。",
        "所怕": "停止观察后被说毫无价值，自己也失下次雇费。",
        "口吻": "先问愿否再写数字；压力下曾把普通物资说成观察名额。",
        "跨案弧线": "03须实际取消物资与观察捆绑，或停止本批；肯纠正不自动取得患者谅解，过去诱导许可不倒写成充分自愿，记录源和拒绝都留史。",
        "体貌": "二十多岁，指节有写字压出的茧；看人时先看手再看脸。",
        "衣着与磨损": "旧抄录员的罩衫，口袋缝着笔插；袖口用线扎紧。",
        "随身物": "记录板与两支炭笔，板上分‘普通’与‘观察’两栏。",
        "举止": "问数之前先问许可；被催时会说‘先让我问完这一句’。",
        "风格守卫": "不写成冷面研究员；她怕丢差事，也知道旧诱导错在哪。"
      }
    }
  ],
