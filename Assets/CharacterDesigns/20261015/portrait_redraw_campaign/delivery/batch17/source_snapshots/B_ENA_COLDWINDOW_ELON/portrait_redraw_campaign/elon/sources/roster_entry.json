  "current_card_fields": [
    {
      "source": "design/04_人物/城市人物/人物_PAS-NPC-ELON_礼昂.md",
      "fields": {
        "稳定ID": "PAS-NPC-ELON",
        "工作": "本案军民两种用途记名的成年装卸工与普通患者",
        "所求": "普通一张床真接住，身份核到本人真愿范围。",
        "所怕": "被两簿漏掉后又被全合簿公开所有家门，或一名两用算出两床已给。",
        "口吻": "指出自己真用过的昵称和实到那张床，不替N7配对两患者合成一个人。",
        "可能弧线": "可编号分柜或自愿限定实名，护理不等研究／军役／家属代理；一个身体与床费只占一次。",
        "体貌": "三十多岁，肩膀结实，手上有装卸的厚茧；右腿站久了会换重心。",
        "衣着与磨损": "装卸工的短褂外罩病号布衫，两种身份穿在一身上。",
        "随身物": "两栏记名的工牌与自己的药单。",
        "举止": "说话先分清‘这是活’还是‘这是病’；被同情时会说‘按单子来’。",
        "风格守卫": "不写成被制度玩弄的符号；两种记名都要他本人答。"
      }
    }
  ],
