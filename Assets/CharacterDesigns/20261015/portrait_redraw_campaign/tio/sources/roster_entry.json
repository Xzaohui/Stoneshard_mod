      "fields": {
        "工作": "归乡学徒。",
        "起点与转折": "要认师傅，也想自己的新工艺有名字。",
        "体貌": "二十多岁，手臂有箍桶磨的痕迹；走路轻快。",
        "衣着与磨损": "学徒围裙，袖口卷起；腰间挂着敲桶小锤。",
        "随身物": "小锤与自己的刻线尺，尺上有新刻的第一条线。",
        "举止": "说话先看桶缝；被问出师时会说‘还早’。",
        "风格守卫": "不写成天才学徒；箍桶与酿酒是两门手艺。"
      }
    }
