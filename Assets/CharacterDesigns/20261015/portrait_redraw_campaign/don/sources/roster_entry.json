    {
      "source": "design/04_人物/城市人物/人物_OSB-NPC-DON_多恩.md",
      "fields": {
        "稳定ID": "OSB-NPC-DON",
        "工作": "芙朵的父亲与本笔旧欠请求人",
        "所求": "让家里下顿能吃，又怕女儿离去后自己只剩欠条。",
        "所怕": "承认暗借女儿未来工班来还债，便失父亲全部分量。",
        "口吻": "先说地里哪袋少了，再慢说自己签过哪条；不能把担心说成女儿已经答应。",
        "可能弧线": "父债用本人真实资产／受准分期另偿；女儿能限期外作也能真留学作，不因留村又可替签。",
        "体貌": "五十多岁，背有些弓，手上有犁柄磨出的长茧；左眼常眯。",
        "衣着与磨损": "旧农褂补丁压在补丁上，腰间系着草绳；帽檐软塌。",
        "随身物": "旧欠字据与磨亮的犁头销钉。",
        "举止": "说话先绕田里的事；要钱时会先说自己不是来讨饭的。",
        "风格守卫": "不写成可怜老人；旧债真、女儿的选择也真。"
      }
    }
  ],
