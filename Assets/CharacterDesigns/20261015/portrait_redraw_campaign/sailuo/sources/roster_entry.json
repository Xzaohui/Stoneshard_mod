      "fields": {
        "稳定ID": "KOR-NPC-SAILUO",
        "工作": "双门里能自主表达的成年年轻人",
        "所求": "取回自己刻过的旧物，用自己选的称呼生活。",
        "所怕": "每个帮过自己的家都要用一件物证明他从此属于谁。",
        "口吻": "指出自己刻错又修正的细节，不靠大声反抗才算自主。",
        "可能弧线": "可本人取或真愿一件代领，仍可能选择和一户同住；同住、同姓和代理不再是一张总同意。",
        "体貌": "二十岁上下，个子高但清瘦，袖口下藏着旧伤；说话时直视对方。",
        "衣着与磨损": "两户拼布缝成的短褂，颜色对不齐；鞋是合脚的旧靴。",
        "随身物": "一只装着两处家门钥匙的布袋，钥匙分系不同色绳。",
        "举止": "被代答时会举手；讲住处时先说自己选哪边。",
        "风格守卫": "不写成需要被裁决的孩子；成年人的去留自己答。"
      }
    }
  ],
