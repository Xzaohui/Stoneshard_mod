  "visual_observations": [
    {
      "pose": "E1",
      "expression": "一侧眉较母图轻挑，眼帘呈含笑收弧但仍睁开，嘴从母图闭口浅笑改为小幅开口干笑；表情呈机灵自嘲，不是大张嘴狂笑。",
      "identity_proportion_costume": "瘦小中年脸、灰鬓发束、颊纹、鼻唇和紧凑本人比例保持；土黄开衩短褂、浅领袖、灰褐裤棕靴及斜背带一致。",
      "hands_and_props": "一根钩杆持续斜背，完整铁钩位于画面左上、完整杆尾在右下，缠布保留；原绳圈在画面右腰、左手扶绳。右手在画面左胸腹附近小幅收指，原浅旧痕仍见。",
      "hard_errors": [],
      "pass": true
    },
    {
      "pose": "E2",
      "expression": "眉内端回拢，眼神专注安静，嘴合为平直短线、唇角不再上扬；同E1开口干笑及母图浅笑明显有别。",
      "identity_proportion_costume": "中年面颊细纹与灰鬓、土黄旧衣、斜背带和裤靴比例保留；没有幼化或怪物化。",
      "hands_and_props": "右手自然降近腰、左手仍扶原腰绳；一根斜背钩杆两端和缠布完整、不当拐杖或拔杆。双腿双脚及站姿保留，旧手部浅痕仍见。",
