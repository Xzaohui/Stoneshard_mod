  "expressions": [
    {
      "key": "leo_E1_scope_challenge",
      "label": "审慎限定",
      "brows": "一侧眉略挑、另一眉内端下压，形成询问式不对称。",
      "eyes": "眼裂收窄、瞳孔横看对话者，保原成熟长眼型。",
      "mouth": "嘴闭合压成短直线，一角轻收，不做轻蔑笑。",
      "head_pose": "原三分之二角，下颏略收。",
      "story_support": "N7人物冲突：起初相信封印；N7-S01-L02可以查本地，不先宣布整支军队有罪。",
      "condition_and_limit": "S61台词仅当前条件下的素材；表情不是已批准检查令，也不是拒绝所有监督或判定全军无罪。"
    },
    {
      "key": "leo_E2_weigh_external_question",
      "label": "受质询衡量",
      "brows": "双眉内端略升、两眉趋对称，区别E1挑眉和E3压平。",
      "eyes": "眼裂比E1打开，目光微下移后落画侧，清醒而无惊恐瞪眼。",
      "mouth": "双唇微分成窄小竖向口，唇角松开；不得微笑或泪目。",
      "head_pose": "头略垂但不低头忏悔，肩甲位置固定。",
      "story_support": "人物卡逐步接受外部监督；N7-R-parallel要求不能把独立查案冒称内部自查。",
      "condition_and_limit": "仅面对质询的权衡表情；若放在parallel结果回访须真实resolve_N7=parallel及本人在场存活愿谈。不证明他已认罪、接受SQ02监督承诺、失去全部权限或被击败。"
    },
    {
      "key": "leo_E3_state_local_limit",
      "label": "清楚划权限",
      "brows": "双眉平稳稍压内端，去掉质问的不对称。",
      "eyes": "直视听者，上睑打开但较E2坚定，下睑稳住。",
      "mouth": "小幅横向发言口型，唇角平，不笑、不咆哮露齿。",
      "head_pose": "近正面、下巴水平，头肩不摆成宣誓。",
      "story_support": "人物卡只持地方签署资格；N16-S01-L02仅能承诺本地封存队程序；N7-S02-L03只说核查的几例。",
      "condition_and_limit": "仅清楚说明权限，不证明签约／封存／结盟已完成。N16演出须已有实际SQ02承诺或合法代理资格，不能用脸补未签回执，不能替王廷或缺席者许愿。"
    }
  ],
