      "fields": {
        "稳定ID": "FOR-NPC-LUOFU",
        "工作": "洗砂生活水接续与排渠维护者",
        "所求": "有真可用替水和本段停流权，不反复逼住户喝水才证明问题。",
        "所怕": "外水方案只画在表上、工班未到，村人却已被写成安全。",
        "口吻": "谈哪段实际封、哪批外水真正到，不由颜色诊断所有病因。",
        "可能弧线": "专业隔流或有限替水都要实费实工，源头未知保未知；住户接受这次款不买往后全体同意。",
        "体貌": "三十多岁，裤脚常有泥点，手背有渠水泡白的痕；说话快。",
        "衣着与磨损": "涉水用的短胶靴，上身是洗砂班的旧罩衣；头巾扎紧。",
        "随身物": "水尺与排渠钩，钩子挂在腰侧。",
        "举止": "先量再说；被催时会说‘水不等人，账要等人’。",
        "风格守卫": "不写成环保口号；她管的是生活水与渠。"
      }
    }
  ],
