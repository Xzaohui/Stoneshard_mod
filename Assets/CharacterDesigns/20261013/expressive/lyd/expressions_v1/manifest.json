  "expressions": [
    {
      "key": "lyd_E1_deliberate_account",
      "label": "从容核述",
      "brows": "两眉比原锚放松，内端轻抬而不拧成恐惧八字；左右微小不对称保个性。",
      "eyes": "视线落稍低的画外听者，眼睑柔和打开，瞳孔明确；不闭眼、不重复低头盯纸。",
      "mouth": "双唇微分成细小纵向口型，嘴角中性放松，像仔细措辞，不能画讨好笑。",
      "head_pose": "原三分之二角，头平稳，仅轻收颏。",
      "story_support": "N6-R-witness让自愿抄写者各认自己部分；人物卡只知自己抄了什么；N10-R-sourcehearing来源分开、可匿名。",
      "condition_and_limit": "只表示审慎自述的情绪，可作为本人存活在场愿谈、授权范围内的核述概念；若使用N6-R-witness-L01须真实resolve_N6=witness及核验；若N10听证须该方法现场核验与本人逐项同意，不凭图认证证词或公开姓名。"
    },
    {
      "key": "lyd_E2_claim_own_turn",
      "label": "坚定自己发言",
      "brows": "眉内端轻压，眉身平稳，明确区别E1舒展眉，不做怒目竖眉。",
      "eyes": "睁开直视画外听者，下睑稳住，保原眼型；不瞪眼、无泪。",
      "mouth": "清楚横向短句开口，唇角平直、有气息但不吼叫；区别E1细小口型。",
      "head_pose": "头略抬到水平，不仰下颏示威；双肩固定。",
      "story_support": "N10 X13-L01：先说自己写过的，而非等凯姆讲完仅回答是不是；N6-R-witness-L01本人说看见哪段。",
      "condition_and_limit": "借X13原句须resolve_N6=witness、N10已收到有限回执或核验告知，且本人存活在场愿谈。单纯表情不替她决定去处、出席、公开真名、原谅凯姆或承担他人责任。"
    }
  ],
