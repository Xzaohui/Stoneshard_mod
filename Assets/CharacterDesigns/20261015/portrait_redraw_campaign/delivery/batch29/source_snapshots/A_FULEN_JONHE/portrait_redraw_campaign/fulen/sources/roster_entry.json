      "fields": {
        "稳定ID": "MNS-NPC-FULEN",
        "工作": "普通护理接收班的容器采购人",
        "所求": "有真适合本班用途的有限水容器，未有前保安全替代。",
        "所怕": "别人把旧酒桶刷过就叫万能药桶，或她拒替代后被说不关心酒业。",
        "口吻": "问材质、旧用途和本班可用，不诊全体病，不代所有护理点收。",
        "可能弧线": "护理优先或实用替代均须受准且实有；可拒不合需要容器，不拿采购单生新桶或复发SQ07。",
        "体貌": "三十多岁，手小但稳，抱着陶罐走也不晃；短发别在耳后。",
        "衣着与磨损": "护理班配的素色褂，外罩防碰的厚围裙。",
        "随身物": "陶罐样品与刻着容量的木签。",
        "举止": "挑罐先敲三下听声；报数时用手指点签。",
        "风格守卫": "不写成后勤杂役；容器关系到每一份护理的实量。"
      }
    }
  ],
