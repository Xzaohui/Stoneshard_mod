      "fields": {
        "稳定ID": "DEN-NPC-VIKO",
        "工作": "暂住患者与愿帮生活的成年人",
        "所求": "保普通护理和本次住所，自选日常活，不签并未认同的家中仪式。",
        "所怕": "为有饭和水被迫装成伊蕾失去的家人，拒绝后又被写成不知恩。",
        "口吻": "温和地指明愿洗哪只碗、不会祷哪句；不替其它患者答去向。",
        "可能弧线": "可留而生活仪式分开，也可迁有限侧屋；前者不假全家同信，后者承认少家常照护与实际新费用。",
        "体貌": "二十多岁，脸色偏白，手腕系着记录用药的布条；动作轻。",
        "衣着与磨损": "借住的旧罩衣宽大，袖口卷三层；披一条自织的薄毯。",
        "随身物": "药布条与一小篮常做的活计（编绳）。",
        "举止": "说话前先坐稳；被代答时会轻轻敲桌提醒。",
        "风格守卫": "不写成需要被安排的床位；她能自己选去向。"
      }
    }
  ],
