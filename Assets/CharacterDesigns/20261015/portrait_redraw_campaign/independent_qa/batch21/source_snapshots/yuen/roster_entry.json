      "fields": {
        "稳定ID": "KOR-NPC-YUEN",
        "工作": "赛洛曾住过一户的养育长辈",
        "所求": "被承认真照顾过，也希望年轻人仍愿回自己门。",
        "所怕": "所选新名像把多年照料换成一段没存在过的日子。",
        "口吻": "叫习惯的称呼会停一下，仍可难过，不让难过变代领全部物的理由。",
        "可能弧线": "可学习问本项，不需马上喜欢新称呼；认旧照料不买未来住处，不用真伪亲属之争锁年轻人。",
        "体貌": "六十岁上下，头发全白，手背青筋明显；坐时习惯把手放在膝上。",
        "衣着与磨损": "旧式长褂，襟口别着家门的旧徽；围巾是赛洛小时候织的。",
        "随身物": "家门旧徽与一册记着孩子身量的旧尺谱。",
        "举止": "说话慢，先讲孩子小时候；被反驳时会说‘你说得也有理’。",
        "风格守卫": "不写成抢孩子的长辈；养育不等于归属裁决。"
      }
    }
  ],
