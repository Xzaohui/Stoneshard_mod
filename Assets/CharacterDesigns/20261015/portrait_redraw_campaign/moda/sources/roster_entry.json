      "fields": {
        "稳定ID": "MNS-NPC-MODA",
        "工作": "有限旅灶采购人与已付错年份酒价者",
        "所求": "买实际能卖给客人的有限新酒，收回付错年份多出的款。",
        "所怕": "承认买错后没脸见老客，又把自己的损失强转给提奥。",
        "口吻": "谈价也谈自己曾夸过的年份；她可撤新单，不叫退款买她继续信这家。",
        "可能弧线": "可认新年份或知情有限家标，但旧多付实退，未卖酒不算退款资金，不索死者私史做广告。",
        "体貌": "四十多岁，腰上系着结实的钱袋带；鼻头红，像常年闻酒。",
        "衣着与磨损": "耐磨的旅行围裙，口袋里插着酒单；靴子沾着酒糟。",
        "随身物": "酒单与样品小瓶，瓶塞标着年份。",
        "举止": "报价先问年份；发现自己付错时会自嘲一句再重算。",
        "风格守卫": "不写成冤大头笑料；错价要按实收更正。"
      }
    }
  ],
