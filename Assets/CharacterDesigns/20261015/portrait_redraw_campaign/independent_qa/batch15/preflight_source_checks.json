      "current_card_fields": [
        {
          "source": "design/04_人物/城市人物/人物_MAE-NPC-BENO_贝诺.md",
          "fields": {
            "稳定ID": "MAE-NPC-BENO",
            "工作": "中立普通护理班接收人",
            "所求": "接得住这一班的病人和工人，不靠虚报床位把下一班压垮。",
            "所怕": "别人称中立就认为他有无限粮、床和工钱，也怕被迫收全城名单。",
            "口吻": "报自己真有的那一床与一班水；不同用途的许可不在一句有我就行里合并。",
            "可能弧线": "可接一个有限转班或维持留城照护，承认排期不完美；不拿等待床位惩罚拒公议的人。",
            "体貌": "三十岁上下，动作利落，手背有消毒水浸白的痕迹。",
            "衣着与磨损": "素色护理褂，袖口用扣带束紧；口袋里插着两支备用布带。",
            "随身物": "接收簿与体温布尺，簿上只写当班。",
            "举止": "先量再问；被塞额外任务时会指簿子说‘这班满了’。",
            "风格守卫": "不写成万能照护；他只能接这一班的人。"
          }
        }
      ],
