  "current_card_fields": [
    {
      "source": "design/04_人物/城市人物/人物_MAE-NPC-KAEM_凯姆.md",
      "fields": {
        "稳定ID": "MAE-NPC-KAEM",
        "工作": "N10已有副馆员，本轮补角色卡",
        "所求": "保存记录，也保自己作为唯一救记录者的地位。",
        "所怕": "独立来源核验让自己的摘要和认证垄断失去价值。",
        "口吻": "以我保下过这些开头；受物证约束只能答自己的日期和归属，不指控全部来源人。",
        "可能弧线": "沿N10已发生责任和存活状态；本城新错归段另核，不能再授旧失印的编辑权，也不能把沉默当新增认罪。",
        "体貌": "四十多岁，头发花白得早，拇指有旧印鉴磨出的硬皮；背微驼。",
        "衣着与磨损": "馆员长褂肘部补丁整齐，内袋缝在右襟；旧印盒挂在腰后。",
        "随身物": "旧印盒与折角的借阅簿，簿上他改过的那页夹着布条。",
        "举止": "说话先引条目再解释；被问旧事时会说‘那页我看过’。",
        "风格守卫": "不写成第二人生或新角色；他就是旧案那位凯姆，卡与责任都共用。"
      }
    }
  ],
