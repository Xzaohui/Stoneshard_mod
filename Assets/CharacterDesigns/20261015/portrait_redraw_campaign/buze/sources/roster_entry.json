    {
      "source": "design/04_人物/城市人物/人物_EED-NPC-BUZE_布泽.md",
      "fields": {
        "稳定ID": "EED-NPC-BUZE",
        "工作": "沉木旧屋产权请求人",
        "所求": "售部分旧梁补自己欠款与修另一处家屋。",
        "所怕": "住户不同意时自己像一生只配出钱，却也怕认早已收过一段订款。",
        "口吻": "先说当年借住有多久，再说已收款；有真帮人也有强替人离开的习惯。",
        "可能弧线": "能退未授权预款、保屋，或真安置后有限拆；失收入不等失全部旧情，借住的恩不变随时赶人权。",
        "体貌": "四十多岁，身材干瘦，常带木屑；右手小指伸不直。",
        "衣着与磨损": "旧屋修缮的粗布衣，肩头搭着测线的墨斗绳。",
        "随身物": "墨斗与一张自己画的旧屋界图。",
        "举止": "说话先铺开图；谈不拢时会收起图说‘那就按契来’。",
        "风格守卫": "不写成占屋者；他拿的是请求，不是定论。"
      }
    }
  ],
