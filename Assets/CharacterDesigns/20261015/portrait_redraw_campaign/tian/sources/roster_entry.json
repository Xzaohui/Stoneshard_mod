  "current_card_fields": [
    {
      "source": "design/04_人物/城市人物/人物_ASH-NPC-TIAN_缇安.md",
      "fields": {
        "稳定ID": "ASH-NPC-TIAN",
        "身份": "妮蔻的成年姐姐、旧屋另一合法住者",
        "所求": "妹妹有照顾，自己在屋中也能安睡。",
        "所怕": "妹妹一回来就得由自己永远照护，或者承认害怕便被说不认家人。",
        "口吻": "递毯子时抓着钥绳，既说真怕也说错把钥匙当条件。",
        "跨案弧线": "01可撤以毯换钥、另分实际照护与共住范围；主章再问是否真能接本班，不以亲属义务造免费床。她仍可怕，不据此夺妹妹旧权。",
        "体貌": "三十多岁，肩窄，眼下有长期缺觉的影；右手总揣在围裙口袋里。",
        "衣着与磨损": "旧屋居家的厚布衫，袖口磨出绒；腰间系着改小的旧围裙。",
        "随身物": "系着钥绳的旧钥匙与一只备用碗。",
        "举止": "递东西时抓牢钥绳；说到‘怕’时会先笑一下。",
        "风格守卫": "不写成夺屋姐姐；怕是真的，妹妹的旧权也是真的。"
      }
    }
  ],
