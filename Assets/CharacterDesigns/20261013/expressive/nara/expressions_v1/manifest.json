  "expressions": [
    {
      "key": "nara_E1_wary_assessment",
      "label": "警觉审视",
      "brows": "近画侧眉略抬、另一粗眉内端压低，轻微不对称。",
      "eyes": "眼裂中等偏窄，瞳孔侧看对话者；上眼睑有重量，眼白仍清楚。",
      "mouth": "嘴闭合，须间唇线横向压紧，一侧嘴角略收；不露齿。",
      "head_pose": "保原三分之二角度，下巴稍收，稳住颈肩。",
      "story_support": "人物卡怕重新被记为可劳作债务人；N2-S03-L01的欠薪／欠债顾虑只作有条件情绪素材。",
      "condition_and_limit": "表达对陌生询问的审视；不是已决定返营、认债或拒绝所有援助。"
    },
    {
      "key": "nara_E2_weary_request",
      "label": "倦中求缓",
      "brows": "双眉内端略抬，外段松开，眉间不做夸张痛褶。",
      "eyes": "眼睑比E1明显下落、向低处看但不闭眼；瞳孔可见，不画昏厥。",
      "mouth": "唇轻分形成小纵向气口，唇角自然下垂；髭须不得吃掉口型。",
      "head_pose": "头微垂，与E1的侧审视拉开，颈肩仍是坐姿休息的自然承托。",
      "story_support": "N2-R-protected-L01“先让我在这里睡一夜”；卡中伤腿与不能爬回堤支持需要休息。",
      "condition_and_limit": "只是疲惫和请求缓一缓，绝不新增疾病、疼痛等级或恶化；引用原路线台词需resolve_N2=protected、存活在场愿谈且原执行守卫成立，图本身不证明已安置。"
    },
    {
      "key": "nara_E3_measured_objection",
      "label": "克制分账",
      "brows": "粗眉两端较平、内端微压，去掉E1单眉挑起，形成有分量的正面申明。",
      "eyes": "眼睑较E2打开，目光直向听者，稳而不瞪。",
      "mouth": "小幅横向开口如清楚说出短句，唇角平，最多一点暗色口腔，不做怒吼露牙。",
      "head_pose": "近正面，下巴恢复水平略前送，不挺身站起。",
      "story_support": "N2-R-return-L01把工资与欠款分开算；N2-R-agency-L01只授权这次救助，支持明确而有限的申明。",
      "condition_and_limit": "两句属于互斥方法，只提炼人物的具体边界，不把return和agency同时完成；未来用原句须对应resolve_N2和存活在场愿谈，不能据脸写入实名同意或授权。"
    }
  ],
