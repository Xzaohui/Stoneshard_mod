      "fields": {
        "稳定ID": "EED-NPC-FOLAN",
        "工作": "本笔私人旧债追讨者",
        "所求": "拿回这笔真实旧款，不再以岗位名簿索无关家人。",
        "所怕": "债务人永远拒谈，自己的真实损失被一句隐私说成不存在。",
        "口吻": "报实际尚欠数，不说所有林户都一样；认自己用过不该给他的住址。",
        "可能弧线": "追已核旧款仍可走有限约见，停止读取地址仍不免既往威吓责任；不能买通巡林者获下一户资料。",
        "体貌": "四十多岁，衣着体面但鞋底薄；习惯把拇指插在腰带里。",
        "衣着与磨损": "布林裁法的旧外套，袖口内衬新换；帽子上没有标记。",
        "随身物": "欠条副本与算珠，珠子磨得圆亮。",
        "举止": "谈钱先谈‘规矩’；被反问时把算珠拨得很响。",
        "风格守卫": "不写成黑帮打手；他只是来收一笔真欠。"
      }
    }
  ],
