      "fields": {
        "稳定ID": "KOR-NPC-XIELAN",
        "工作": "本幅旧画的有限购画人",
        "所求": "买真画工与受准实物，不买没有来源的显贵身份。",
        "所怕": "付了贵族故事的钱却只能得到一张普通脸，又被说不给价就是不尊重家族。",
        "口吻": "谈背板和笔触，不靠猜像谁来宣布城主。",
        "可能弧线": "可真按未知价购一次、也可拒新成交；实际旧价款有则另核，不给寄售人无限留展赞助。",
        "体貌": "五十岁上下，身姿端正，指上有旧墨痕；目光总落在画角。",
        "衣着与磨损": "本地体面的深蓝长衣，领口别着收藏人的素签。",
        "随身物": "购画预算单与一小卷衬纸。",
        "举止": "看画先看纸背；出价前会把袖口挽好。",
        "风格守卫": "不写成附庸风雅者；他买的是有限范围，不替族史作证。"
      }
    }
  ],
