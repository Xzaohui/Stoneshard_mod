      "fields": {
        "稳定ID": "DEN-NPC-ODO",
        "工作": "卡蕾的丈夫与普通渔工",
        "所求": "回来过自己的日子，不再用一班驻点工作换房。",
        "所怕": "妻子为要回家把他替签成驻点工，曾被指认的家事再次被当补位理由。",
        "口吻": "感激妻子等家，也有硬的拒绝；认眼前伤者需要而不承诺谅解。",
        "可能弧线": "可同船或分船，都保本人作工选择；肯这一趟不等重新效劳或交家门。",
        "体貌": "三十多岁，肩背厚，右手有渔线割出的浅纹；走路外八。",
        "衣着与磨损": "补过多处的胶布雨裤，上身是本地短褂；腰间挂鱼刀。",
        "随身物": "鱼刀与一张写着潮时的木牌。",
        "举止": "说话前先看天；谈家里事时会把刀解下放桌上。",
        "风格守卫": "不写成沉默暴夫；他也在学怎么把话讲开。"
      }
    }
  ],
