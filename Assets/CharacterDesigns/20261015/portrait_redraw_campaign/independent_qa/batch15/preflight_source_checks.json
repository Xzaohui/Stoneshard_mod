      "current_card_fields": [
        {
          "source": "design/04_人物/城市人物/人物_MAE-NPC-DORO_多罗.md",
          "fields": {
            "稳定ID": "MAE-NPC-DORO",
            "工作": "维芮的姐姐与日常照护人",
            "所求": "这几天有粮，妹妹也有能自主决定的日子。",
            "所怕": "被当成卖掉家史的贪人，自己的劳作又被一件衣物完全盖住。",
            "口吻": "算自己实际端过几碗、缝过几处，也能承认拿妹妹的沉默当愿意过。",
            "可能弧线": "可以学会把求助和卖物分开，有限过渡仍紧；拒继续代理某笔交易不等于拒妹妹。",
            "体貌": "四十岁，手背粗糙，指节大；眼角有睡眠不足的青。",
            "衣着与磨损": "厨房围裙系两圈，袖子永远卷到手肘；发巾束得紧。",
            "随身物": "药匙与记着轮班的布牌，布牌挂在门后钉上。",
            "举止": "说话先报今天喂过什么；被劝休息时先笑再沉默。",
            "风格守卫": "不写成牺牲圣母；她的疲劳要能被看见。"
          }
        }
      ],
