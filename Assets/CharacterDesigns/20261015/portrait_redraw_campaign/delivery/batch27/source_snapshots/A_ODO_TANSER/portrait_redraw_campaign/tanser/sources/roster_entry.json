      "fields": {
        "稳定ID": "DEN-NPC-TANSER",
        "工作": "受伤的驻点工与旧指认经手者",
        "所求": "得到这一班普通转运与护理，承认自己当年指过的人名。",
        "所怕": "伤痛被当无伤演戏，也怕自己的承认被用来索整份驻点名册。",
        "口吻": "先说腿与能走哪段，再说本人知道的旧指认；不拿呻吟换原谅。",
        "可能弧线": "救助不清旧责，接收者只核本案授权；不能趁上船得全家住址，不以受伤自动成为好人。",
        "体貌": "四十岁上下，一条腿落地轻，拄一根短木杖；眉间有旧缝痕。",
        "衣着与磨损": "驻点工的厚褂，膝部加皮片；杖头包着布防滑。",
        "随身物": "短木杖与旧指认记录折页。",
        "举止": "坐下前先把杖放好；认错时会说清哪一天、哪一栏。",
        "风格守卫": "不写成被清算对象；旧指认与新伤分开算。"
      }
    }
  ],
