      "fields": {
        "稳定ID": "PAS-NPC-WOTIN",
        "工作": "本段修路带班人与催主关车的人",
        "所求": "保已做石段被承认，想大车恢复而不愿认先前拖班薪。",
        "所怕": "货迟算自己没能力，放人收工就像否认他们真为关口做过。",
        "口吻": "报实际完工段与未付班，曾把不说累当专业用来逼同伴。",
        "可能弧线": "可真托工资且自愿续一班，或停未完段保有限旁路；军事急需不使未来无限无薪。",
        "体貌": "四十多岁，身板厚，嗓门亮；左臂有一道修路留下的长疤。",
        "衣着与磨损": "修路工的厚褂，膝部绑着草垫；腰间别着哨子与短尺。",
        "随身物": "哨子与工段木牌，木牌上钉着停工钉。",
        "举止": "开口先报段号；被催时会指着路让看。",
        "风格守卫": "不写成恶工头；他要的是路和工钱都算清。"
      }
    }
  ],
