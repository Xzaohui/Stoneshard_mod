  "expressions": [
    {
      "key": "nell_E1_guarded_question",
      "label": "戒备询问",
      "eyes": "双眼明显向画侧对话者偏移，上眼睑压低但视线警觉；保留清晰眼白。",
      "brows": "近对话侧眉轻抬，另一眉保持水平内收，形成可见不对称。",
      "mouth": "嘴闭合、唇角微收一侧，非微笑。",
      "head_pose": "三分之二侧朝对话者，头微后收，下巴水平。",
      "story_support": "卡中的藏账自保；N3-S02-L01“你带着他们的票来？”仅为场面素材。",
      "condition_and_limit": "询问时的戒备，不表达已经交出账簿、接受公开作证或得到保护。"
    },
    {
      "key": "nell_E2_alarm_boundary",
      "label": "不安设界",
      "eyes": "眼睑较E1明显打开，瞳孔向对话者，勿夸张成惊恐圆眼。",
      "brows": "双眉内端抬高并向中聚，外端略下压。",
      "mouth": "唇自然分开，短促发言的小不规则开口；下唇略紧，不露大排牙。",
      "head_pose": "更接近正面，微偏头后退，不能靠耸肩代替脸。",
      "story_support": "卡中住址页自保与N3-R-testimony要求先移出住址字段；N3-S03-L01只作边界情绪素材。",
      "condition_and_limit": "仅表达不愿被公开住址；不画认罪哭诉、已受保护、公开证言或审判结论。"
    },
    {
      "key": "nell_E3_controlled_resolve",
      "label": "克制申明",
      "eyes": "目光正视，眼裂较E1更稳更集中、较E2更窄。",
      "brows": "双眉内端略低，舒平额部，坚定而不凶狠。",
      "mouth": "嘴小幅横向张开如清楚说完一句，唇线平直；不露笑。",
      "head_pose": "近正面、下巴轻抬，与E2退缩显著不同。",
      "story_support": "N3-R-testimony-L01、N3-R-collective-L01中的限定责任与他人自主边界，仅抽取克制申明情绪。",
      "condition_and_limit": "独立情绪研究，不绑定路线结果。若未来套用这些原句，必须遵原resolve_N3及存活在场愿谈条件；本图不代表已经认罪、受监督补账或取得原谅。"
    }
  ],
