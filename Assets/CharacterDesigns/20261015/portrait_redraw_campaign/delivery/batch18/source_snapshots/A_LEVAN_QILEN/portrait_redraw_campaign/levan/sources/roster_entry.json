    {
      "source": "design/04_人物/城市人物/人物_PAS-NPC-LEVAN_列梵.md",
      "fields": {
        "稳定ID": "PAS-NPC-LEVAN",
        "工作": "关外临时装车工与本封家书作者",
        "所求": "把真想家的这一段送到受准接收者，也能另问这班工怎样结束。",
        "所怕": "写想家就被认逃岗，代理送一封便能替他答所有家门与未来工。",
        "口吻": "信写哪句就只准哪句，没纸也不多送一份心事。",
        "可能弧线": "可以书信或有限口信，岗位合同另核无自动赦免；传信不续岗、不授地址售价，不重演原逃兵情节。",
        "体貌": "二十多岁，手掌有绳勒的新茧，指节写字的茧也在；头发自己剪的。",
        "衣着与磨损": "装车工的粗布短打，外披家里的旧斗篷；内袋专门放信纸。",
        "随身物": "一封写好的家书与随身的小墨盒，墨盒快空了。",
        "举止": "说话前先看信还在不在；托人时会把信双手递出。",
        "风格守卫": "不写成苦情信使；信送出后他自己也空着手。"
      }
    }
  ],
