      "fields": {
        "稳定ID": "OSB-NPC-BUXI",
        "工作": "本批有限粮采购人",
        "所求": "取得真有的有限粮，不把明年所有收成买成今天已经到仓。",
        "所怕": "薄收让已付钱拿不回，或自己被期待替全村长期兜底。",
        "口吻": "说这一批、这一季和实到哪袋，不替布林所有商户承诺价格。",
        "可能弧线": "实际预购限一季与数量，承担受准薄收风险；也能拒新订单，既付旧款不因此撤成未付。",
        "体貌": "四十岁上下，手指关节粗，数粮时用掌量；鼻子常沾面粉。",
        "衣着与磨损": "本地粮行的厚围裙，口袋缝成双层；袖子挽到手肘。",
        "随身物": "量斗与采购单，单上按村分栏。",
        "举止": "先报实到量再谈价；被压价时会量给你看。",
        "风格守卫": "不写成囤积者；他买的是明列的这批。"
      }
    }
  ],
