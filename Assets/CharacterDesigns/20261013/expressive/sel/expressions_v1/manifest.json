  "expressions": [
    {
      "key": "sel_E1_persuasive_pitch",
      "label": "试探劝说",
      "eyes": "眼睛比锚略开，视线集中在画侧听者。",
      "brows": "一眉抬高、另一眉略松，呈算计中仍在说服的神色。",
      "mouth": "一侧唇角微扬且嘴小开，带短促讨价还价口型，绝非灿笑／邪笑。",
      "head_pose": "三分之二侧微向听者前倾，下巴略抬。",
      "story_support": "现行N4-DEFAULT请求玩家补担保。",
      "condition_and_limit": "只是在提出要求；没有玩家签字、工人同意或工坊得救的结果。"
    },
    {
      "key": "sel_E2_pressed_defensive",
      "label": "受压反驳",
      "eyes": "两眼明显收窄，直视质疑者。",
      "brows": "双眉内端明显下压并聚拢；与E1单眉抬高形成清晰差异。",
      "mouth": "下颌微紧，嘴横向开成反问的窄口，能看到唇而非被髭须吞没；不咆哮龇牙。",
      "head_pose": "更接近正面，下巴向前少许，脸上紧张而非用手指责。",
      "story_support": "现行人物冲突及三路线成本；N4-S02-L02“谁来出这笔”仅作反问情绪素材。",
      "condition_and_limit": "不将争辩画成攻击玩家、幕后阴谋暴露或已认罪。"
    },
    {
      "key": "sel_E3_worried_calculation",
      "label": "忧虑盘算",
      "eyes": "目光明显低垂偏侧，眼睑放松但不闭眼；不能只是把E2瞳孔挪动。",
      "brows": "内眉抬起形成疲惫的浅忧纹，外眉放低。",
      "mouth": "紧闭、下唇轻收、嘴角略向下；与E1/E2开口状态相区别。",
      "head_pose": "头下倾约十度，仍露清楚完整面部；不垂首谢罪。",
      "story_support": "N4-R-installments与liquidate成本：收入慢／岗位减少／失去大器具能力；用于预览代价时的盘算。",
      "condition_and_limit": "只担心未来成本，不表示已停炉、卖掉器具、清债、认错或获得新工作。"
    }
  ],
