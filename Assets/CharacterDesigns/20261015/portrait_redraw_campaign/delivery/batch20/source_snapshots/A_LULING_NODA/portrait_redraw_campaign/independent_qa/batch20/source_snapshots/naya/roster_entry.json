      "fields": {
        "稳定ID": "KOR-NPC-NAYA",
        "工作": "未到旅人兰衍的成年妹妹",
        "所求": "找哥哥消息，拿回未准整月款，也能自选是否在驿里再住。",
        "所怕": "不再付整月被说不肯等哥哥，自己等下去又只剩一张账。",
        "口吻": "信里一晚说一晚；想他不等准替他住每晚。",
        "可能弧线": "可按一晚清租或真封争款自选短宿，仍愿等也限自己范围；哥哥缺席不判死、不让妹妹全权代他。",
        "体貌": "二十多岁，和哥哥一样有细长的眼；发辫绕两圈。",
        "衣着与磨损": "赶路的实用装束，外披挡风斗篷；袖口别着兄长留的徽针。",
        "随身物": "兄长的旧徽针与半张行程表。",
        "举止": "说话先报哥哥的原话；被同情时会说‘先把人找到’。",
        "风格守卫": "不写成等待被安慰者；她要的是人和下落。"
      }
    }
  ],
