  "selected_poses": [
    {
      "id": "K1_single_knee_rest",
      "label_zh": "单膝落地短歇",
      "unique_gap": "从现有双靴支撑或凳面承臀，改为一只前靴全底接地＋后膝/小腿近地支撑；身体形成不对称低位轮廓。",
      "pose_description": "沿I0朝画面右的三分之四视角。画面右侧腿前置、前膝屈曲、前靴全底着地；画面左侧腿折回，后膝明确落在同一地面平面，小腿向后连接完整短靴。髋部降低但躯干近直立、只轻微前倾；一手轻放前侧大腿近膝处，另一手自然垂于身体侧面，均为空手。不画下跪过程或起身。",
      "silhouette_acceptance": [
        "缩到既有板的角色展示尺寸，仍一眼可辨单膝地面接触，不能只是I2俯身挪手。",
        "前膝明显高于着地后膝；一条大腿前伸、一条大腿下落，髋—膝—踝连接可读。",
        "低位轮廓来自关节折叠，不压缩头、不拉长胫骨、不把整人缩小。"
      ],
      "joint_support_acceptance": [
        "保留完整前靴底地接触，后膝前下缘有可读地面接触，不留透明悬缝、不穿地。",
        "后膝—小腿—后靴连续；后靴不能突然增长、卷尖、消失，也不能穿过前脚。",
        "胸腹重心保持前靴与后膝支撑区域内；不把头倾成失衡前扑。",
        "前手掌搭在前大腿上缘，手腕接袖且不穿膝；另一手完整可见。",
        "透视允许近远接触点y值不同，禁止为了共y强拉腿；检视板画简明地面导线辅助判断。"
      ],
      "identity_acceptance": [
        "保留I0成年脸、粗眉、鼻嘴、灰绗缝兜帽、蓝灰绗缝衣、腰带方扣、棕裤/手套/短靴。",
        "同一视角下头帽尺度以I0约328px为参考；若明显变大变小或腿身趋细长直接拒收，不以重采样掩饰。",
        "无武器、凳子、新护膝、背包、地面道具、伤口、泪、祈祷或投降手势。"
      ],
      "failure_policy": "若新图膝地接触不明确、只是现有俯身/弓步近似、腿长漂移或换脸，停止将其计为补缺；保留失败证据，不扩成步态/多阶段/GIF以凑完成。",
      "future_deliverable_if_assigned": "1张透明完整身体PNG＋含I0/I2/R2对照与膝靴接触近景的静态检视板＋原稿/提示词/hash/独审资料；I0/I2/R2仅参考复用，不计新绘。"
