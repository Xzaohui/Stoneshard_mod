      "fields": {
        "稳定ID": "KOR-NPC-LULING",
        "工作": "另一同姓屋的借住户主",
        "所求": "把寄过在自家的物实际还清，也怕被当成从未帮助过。",
        "所怕": "取物后失住客和修门关系，或被要求为别人宣告全家真正来历。",
        "口吻": "说哪段寄在自己的屋，不能替邻家认全部族史。",
        "可能弧线": "可以真交有限件、另谈到期房费；不能因同姓吞物或公共侧路，不保永久免费住房。",
        "体貌": "四十多岁，眉眼精明，数钱时拇指快速弹动；牙齿有一颗金边。",
        "衣着与磨损": "体面的深色外褂，内衬是本地好料；袖扣常换样式。",
        "随身物": "借住契约与同姓屋的钥匙。",
        "举止": "开口先划界线：‘同姓归同姓，屋归屋’。",
        "风格守卫": "不写成反派屋主；她守住的是自己的契约。"
      }
    }
  ],
