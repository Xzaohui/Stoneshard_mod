<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MslDir Condition="'$(MslDir)' == ''">D:\SteamLibrary\steamapps\common\Stoneshard\msl</MslDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="UndertaleModLib"><HintPath>$(MslDir)\UndertaleModLib.dll</HintPath></Reference>
    <Reference Include="ModShardLauncher"><HintPath>$(MslDir)\ModShardLauncher.dll</HintPath></Reference>
  </ItemGroup>
</Project>
