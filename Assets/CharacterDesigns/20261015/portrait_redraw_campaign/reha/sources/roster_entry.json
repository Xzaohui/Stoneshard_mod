  "current_card_fields": [
    {
      "source": "design/04_人物/聚落人物/人物_SKO-S02-NPC_雷哈.md",
      "fields": {
        "日常工作": "归来者的父亲。",
        "动机、缺点与可能转折": "筹赎款时靠儿子终会成为英雄支撑自己，见人回来才发现儿子只想安静。允许离开让他失去替筹款者讲圆故事的面子；有限留班也不是重新出征。他能承认爱与控制曾混在一起，却不被儿子一句原谅自动赎清。",
        "生活台词": "「钱让他回来。我没有买回来下一次出发。」",
        "体貌": "五十多岁，背微驼，手背有等候时捏出的红印；说话慢。",
        "衣着与磨损": "朴素旧外套，扣子换过颜色不一；口袋里塞着一块干净布。",
        "随身物": "儿子的旧鞋一只与赎金收条残角。",
        "举止": "说话先看门口；听到脚步会站起来又坐下。",
        "风格守卫": "不写成苦情父亲；归来不抹旧账，钱与人都要算。"
      }
    }
  ],
