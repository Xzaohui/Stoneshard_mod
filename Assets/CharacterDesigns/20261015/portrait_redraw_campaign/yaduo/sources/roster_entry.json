      "fields": {
        "稳定ID": "OSB-NPC-YADUO",
        "工作": "蔻芙的成年订婚对象",
        "所求": "和她有实际共同生活，不让家中催地来决定两人关系。",
        "所怕": "退土地部分礼被家人说受骗，自己又怕她保地就是准备离开。",
        "口吻": "会承认自己把不安接成了产权；可以真难过，但不能替她答愿婚。",
        "可能弧线": "可支持退地礼而继续相处，也能分开退受准礼；自家失体面不买菜地、取水或成婚。",
        "体貌": "二十多岁，肩宽手大，指甲修得整齐；笑起来有点腼腆。",
        "衣着与磨损": "干净的田庄短褂，靴子刷过；腰带是新打的。",
        "随身物": "订亲小盒与一把新镰。",
        "举止": "谈到婚事看蔻芙；谈到地时先退半步让长辈说。",
        "风格守卫": "不写成上门女婿模板；他不是地权的自动继承人。"
      }
    }
  ],
