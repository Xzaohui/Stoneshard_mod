    {
      "source": "design/04_人物/城市人物/人物_SKO-NPC-WENNO_温诺.md",
      "fields": {
        "稳定ID": "SKO-NPC-WENNO",
        "工作": "冷却工序维护者",
        "所求": "把这段渣槽与冷却交班做实，不替全部疾病作结论。",
        "所怕": "老板要快、家属要钱，自己的停沟报告被当成不关心未归的人。",
        "口吻": "讲时刻、槽向和哪一班能动；拒让患者再碰水作示范。",
        "可能弧线": "有限隔流会慢冷却，替水会花实际费；不能靠说专业就有无限人手和净水。",
        "体貌": "五十岁上下，手臂旧烫痕连成片；站立时重心偏右脚。",
        "衣着与磨损": "湿布披肩不离身，皮手套剪去指尖以便摸温。",
        "随身物": "测温杆与换班木牌，木牌记着水温档。",
        "举止": "用温度说话：‘这炉可以’或‘还早’；不与人争辩概念。",
        "风格守卫": "不写成安全官；他只能保证自己这一序。"
      }
    }
  ],
